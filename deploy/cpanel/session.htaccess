Options -Indexes
DirectoryIndex index.html
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://pr.wealthos.ir%{REQUEST_URI} [R=308,L,NE]
# Node's session gate protects the shell, assets and all private APIs.
# Install only after the new gate is deployed and verified behind the old Basic guard.
RewriteRule ^(.*)$ http://127.0.0.1:31056/$1 [P,L,NE]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "no-store"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
