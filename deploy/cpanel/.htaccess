Options -Indexes
DirectoryIndex index.html

AuthType Basic
AuthName "WealthOS PR Private Preview"
AuthUserFile /home/wealthos/pr.wealthos.ir/.htpasswd
Require valid-user

<Files ".htpasswd">
  Require all denied
</Files>

RewriteEngine On
# Proxy the complete application through Node. cPanel's Apache ownership policy
# can reject deploy-user-owned static files even when POSIX ACLs allow reads.
RewriteRule ^(.*)$ http://127.0.0.1:31056/$1 [P,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "no-store"
</IfModule>
