{
  "name": "@wealthos/pr",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Brand & PR Operating System",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval:model-input-safety && pnpm eval:memory-retrieval && pnpm eval:authentic-execution",
    "dev": "tsx watch src/main.ts",
    "db:test:integration": "tsx scripts/postgres-integration.ts",
    "db:test:restore": "tsx scripts/postgres-restore-verify.ts",
    "db:commission": "tsx scripts/postgres-commission.ts",
    "eval:model-input-safety": "tsx scripts/run-model-input-safety-evaluation.ts",
    "eval:memory-retrieval": "tsx scripts/run-memory-retrieval-evaluation.ts",
    "eval:authentic-execution": "tsx scripts/run-authentic-execution-evaluation.ts",
    "lint": "eslint .",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:scan": "tsx scripts/scan-secrets.ts && pnpm security:audit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:build": "pnpm --dir apps/web build",
    "web:dev": "pnpm --dir apps/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
