NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PR_BIND_HOST=127.0.0.1

# Production fails closed without PostgreSQL. This override is only for a
# Basic-Auth protected, disposable owner preview whose state may be reset.
# PR_ALLOW_EPHEMERAL_PRODUCTION=true

# Configure all three together to enable persistent PostgreSQL state.
# A non-loopback host must use sslmode=verify-full.
# DATABASE_URL=postgresql://pr:change-me@127.0.0.1:5432/pr
# PR_TENANT_ID=11111111-1111-4111-8111-111111111111
# PR_OWNER_USER_ID=22222222-2222-4222-8222-222222222222

# One-time commissioning only. Keep the migration role separate from DATABASE_URL,
# inject both URLs from a secret store, run `pnpm db:commission`, then unset the
# migration credential. Never put these values in Git or a release archive.
# PR_MIGRATION_DATABASE_URL=postgresql://pr_migrator:change-me@127.0.0.1:5432/pr
# PR_TENANT_SLUG=wealthos-pr
# PR_TENANT_DISPLAY_NAME=WealthOS PR
# PR_OWNER_EXTERNAL_SUBJECT=owner:wealthos-pr
