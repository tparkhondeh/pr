NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Production fails closed without PostgreSQL. This override is only for a
# Basic-Auth protected, disposable owner preview whose state may be reset.
# PR_ALLOW_EPHEMERAL_PRODUCTION=true

# Configure all three together to enable persistent PostgreSQL approval state.
# DATABASE_URL=postgresql://pr:change-me@127.0.0.1:5432/pr
# PR_TENANT_ID=11111111-1111-4111-8111-111111111111
# PR_OWNER_USER_ID=22222222-2222-4222-8222-222222222222
